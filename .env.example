# Not required at boot anymore — you enter the number in the web pairing UI.
# Comma-separated list of owner numbers (with country code, no '+'), used for owner-only commands
OWNER_NUMBERS=15551234567

# Prefix for commands
PREFIX=.

# Port for the keep-alive web server (Render/Railway set this automatically)
PORT=3000

# Bot display name used in menu/alive replies
BOT_NAME=MD-Bot
